# ---------------------------------------------------------------------------
# VYBE — environment template.  Copy to .env and fill in.  NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Postgres (docker compose provides these defaults) ---
VYBE_DB_DSN=postgres://vybe:vybe@localhost:5432/vybe?sslmode=disable

# --- Redis (ephemeral only: presence, rate limits, pub/sub) ---
VYBE_REDIS_ADDR=localhost:6379

# --- HTTP ---
VYBE_HTTP_ADDR=:8080
VYBE_ENV=local                    # local | dev | staging | production
VYBE_LOG_LEVEL=debug              # debug | info | warn | error

# --- Auth (ADR-011).  Generate with: go run ./cmd/api -genkeys ---
# Ed25519 private key, PEM, base64-encoded.  Rotate per docs/SECURITY.md.
VYBE_JWT_PRIVATE_KEY_B64=
VYBE_ACCESS_TOKEN_TTL=15m
VYBE_REFRESH_TOKEN_TTL=1440h      # 60 days
VYBE_WS_TICKET_TTL=60s

# --- Content metadata provider (ADR-012) ---
# Free key from https://www.themoviedb.org/settings/api
# Required to run `go run ./cmd/probe tmdb`.  The app proxies all provider
# calls through the backend — this key is NEVER shipped in the Flutter binary.
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
